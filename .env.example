# ---- LiveKit Cloud (required) --------------------------------------------
# Create a project at https://cloud.livekit.io, then Settings -> Keys.
# LIVEKIT_URL is the project's WebSocket URL shown on the project overview page.
LIVEKIT_URL=wss://your-project-abc123.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=replace-with-the-secret-shown-once-when-you-create-the-key

# ---- Database (accounts, presence, invites) ---------------------------------
# Local development: a SQLite file, created automatically. Nothing to install.
# DATABASE_URL=file:./data/lingo.db
# Production (Vercel has no persistent disk): a Turso database.
#   https://turso.tech -> create database -> copy the libsql:// URL and create a token
# DATABASE_URL=libsql://lingo-voice-yourname.turso.io
# DATABASE_AUTH_TOKEN=eyJ...

# ---- Optional --------------------------------------------------------------
# How long an issued join token stays valid (seconds). Tokens are only checked
# when (re)joining; the client fetches a fresh token when it has to rejoin.
LIVEKIT_TOKEN_TTL_SECONDS=7200
# Role given to participants who do not request one: host | speaker | listener
DEFAULT_PARTICIPANT_ROLE=speaker
# Server log verbosity: debug | info | warn | error
LOG_LEVEL=info

# ---- Local development against a LOCAL LiveKit server (instead of Cloud) ----
# brew install livekit && livekit-server --dev   (API key "devkey", secret "secret")
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
